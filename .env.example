# .env.example — copy this file to .env (in the same repo root folder) and fill in your own values.
# .env is git-ignored, so your passwords never reach GitHub. Never put real values in this file.
# On Render there is no .env file: the same names are set in each service's "Environment" tab
# (see docs/deploy.md).

# The port the server listens on (a numbered "door" on your computer). Render sets PORT itself.
PORT=3001

# The address(es) of the browser app. The server only accepts browser connections from these (CORS).
# http://localhost:5173 is always allowed, even if it's not listed. Several addresses: separate them
# with commas, e.g. https://proxispeak-client.onrender.com,https://another.example.com (no "/" at the end).
CLIENT_ORIGIN=http://localhost:5173

# Where MongoDB is. This default is a local MongoDB on your own laptop.
# For Atlas (MongoDB's cloud), paste your own connection string here, in .env only.
# Its shape: mongodb+srv://<user>:<password>@<cluster-host>/proxispeak?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/proxispeak

# ---- Sign-in (v5, the Infotact office) ----
# The key that signs sign-in tokens (HMAC). Any long random text, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If it is empty, the server makes a random key at every start (everyone must sign in again after a restart).
AUTH_SECRET=
# The password for the Admin tab of the sign-in page (email admin@infotact.demo in the demo directory).
# If it is empty, admin sign-in is switched off.
ADMIN_PASSWORD=

# ---- Browser settings ----
# Vite (the client) reads this same file. Only names that start with VITE_ reach the browser,
# and anything that reaches the browser can be seen by anyone who opens the app.
# They are baked in when the client is built, so after changing one, build (or restart Vite) again.

# Address of the server for the browser. Leave it commented out to use http://localhost:3001.
# On Render: https://<your-server-name>.onrender.com
# VITE_SERVER_URL=

# TURN relay server, for when routers block a direct voice connection. Used only when all three are set.
# The address(es) of the TURN server. Several addresses: separate them with commas, e.g. (Metered)
# turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
# VITE_TURN_URL=
# The TURN user name.
# VITE_TURN_USERNAME=
# The TURN password. It ends up in the browser code, so use a TURN credential made only for this app.
# VITE_TURN_CREDENTIAL=

# Redis, used to share messages between two copies of the server (Week 3). Leave commented out until then.
# REDIS_URL=

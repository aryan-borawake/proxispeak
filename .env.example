# .env.example — copy this file to .env (in the same repo root folder) and fill in your own values.
# .env is git-ignored, so your passwords never reach GitHub. Never put real values in this file.

# The port the server listens on (a numbered "door" on your computer).
PORT=3001

# The address of the browser app. The server only accepts browser connections from here (CORS).
CLIENT_ORIGIN=http://localhost:5173

# Where MongoDB is. This default is a local MongoDB on your own laptop.
# For Atlas (MongoDB's cloud), paste your own connection string here, in .env only.
MONGODB_URI=mongodb://127.0.0.1:27017/proxispeak

# TURN relay server, for when a direct voice connection is blocked (Week 4). Leave commented out until then.
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Redis, used to share messages between two copies of the server (Week 3). Leave commented out until then.
# REDIS_URL=
